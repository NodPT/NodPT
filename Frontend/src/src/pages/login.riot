<login-page>
  <div class="container-fluid min-vh-100 d-flex align-items-center p-0" data-theme={state.isDarkTheme ? 'dark' : 'light'
    }>
    <div class="row gx-0 w-100">
      <div class="col-md-6 d-none d-md-flex bg-light align-items-center justify-content-center">
        <div class="container">
          <div class="row justify-content-center w-100">
            <div class="col-11 col-lg-9 p-5">
              <p class="lead text-muted mb-4">Create powerful AI workflows with visual node-based programming.</p>
              <ul class="list-unstyled text-muted">
                <li class="d-flex align-items-start mb-3">
                  <i class="bi bi-robot me-3 fs-4 text-primary"></i>
                  <div>
                    <div class="fw-semibold">Intelligent automation</div>
                    <small>Agents coordinating to solve complex tasks.</small>
                  </div>
                </li>
                <li class="d-flex align-items-start mb-3">
                  <i class="bi bi-diagram-3 me-3 fs-4 text-primary"></i>
                  <div>
                    <div class="fw-semibold">Visual programming</div>
                    <small>Drag-and-drop node flows for any workflow.</small>
                  </div>
                </li>
                <li class="d-flex align-items-start">
                  <i class="bi bi-rocket-takeoff me-3 fs-4 text-primary"></i>
                  <div>
                    <div class="fw-semibold">Rapid deployment</div>
                    <small>From prototype to production quickly.</small>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-md-6 d-flex align-items-center justify-content-center">
        <div class="container">
          <div class="row justify-content-center w-100">
            <div class="col-11 col-sm-10 col-md-9 col-lg-7 col-xl-6">
              <div class="card shadow-sm my-5">
                <div class="card-body p-4">
                  <a href="/" class="text-decoration-none">
                    <img src="/images/logo.png" alt="NodPT Logo" class="ms-0 login-logo" />
                  </a>
                  <h2 class="h4 fw-bold mb-1">Welcome Back</h2>
                  <p class="text-muted mb-3">Sign in to your account using your social network</p>

                  <div if={state.loginMessage} class={"alert " + state.loginMessageClass} role=" alert">
                    {state.loginMessage}
                  </div>

                  <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-primary d-flex align-items-center justify-content-center gap-2"
                      onclick={onGoogle} disabled={state.isLoading} aria-label="Sign in with Google">
                      <span if={!state.isLoading}><i class="bi bi-google"></i></span>
                      <span if={state.isLoading} class="spinner-border spinner-border-sm" role="status"
                        aria-hidden="true"></span>
                      <span>Continue with Google</span>
                    </button>
                  </div>

                  <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" checked={state.rememberMe}
                      onchange={toggleRememberMe} id="rememberMe" />
                    <label class="form-check-label" for="rememberMe">
                      Remember me for 72 hours
                    </label>
                  </div>

                  <p class="small text-muted">By signing in, you agree to our <a href="/terms">Terms and Conditions</a>.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { router } from '@riotjs/route'
    import authApiService from '../services/authApiService'

    export default {
      state: {
        rememberMe: true,
        isLoading: false,
        loginMessage: '',
        loginMessageClass: '',
        isDarkTheme: true,
        isDevelopment: import.meta.env.VITE_ENV === 'Development'
      },
      onMounted() {
        authApiService.setApi(this.api)
        this.loadTheme()
      },
      applyBodyTheme(isDark) {
        if (typeof document !== 'undefined' && document.body) {
          document.body.setAttribute('data-theme', isDark ? 'dark' : 'light')
        }
      },
      loadTheme() {
        const savedTheme = localStorage.getItem('appTheme')
        const isDark = savedTheme ? savedTheme === 'dark' : true
        this.update({ isDarkTheme: isDark })
        this.applyBodyTheme(isDark)
      },
      toggleRememberMe(event) {
        this.update({ rememberMe: event.target.checked })
      },
      showMessage(message, isError = false) {
        this.update({
          loginMessage: message,
          loginMessageClass: isError ? 'alert-danger' : 'alert-success'
        })

        clearTimeout(this.messageTimeout)
        this.messageTimeout = setTimeout(() => {
          this.update({ loginMessage: '', loginMessageClass: '' })
        }, 5000)
      },
      async handleSocialLogin(providerName) {
        if (this.state.isLoading) return

        this.update({ isLoading: true, loginMessage: '', loginMessageClass: '' })

        try {
          // Perform the social login
          await authApiService.loginAndStore(this.state.rememberMe, providerName)
          this.showMessage('Login successful! Redirecting...', false)
          // Redirect to the editor after a short delay
          setTimeout(() => {
            router.push('/project')
          }, 1000)

        } catch (error) {
          console.error(`${providerName} login error:`, error)

          if (error.response && error.response.data && error.response.data.message) {
            this.showMessage(`Login failed: ${error.response.data.message}`, true)
          } else if (providerName === 'Google' && error.message) {
            this.showMessage(`Login failed: ${error.message}`, true)
          } else {
            this.showMessage(`${providerName} login is not fully configured yet. Please use Google login.`, true)
          }
        } finally {
          this.update({ isLoading: false })
        }
      },
      async onGoogle() {
        await this.handleSocialLogin('Google')
      }
    }
  </script>
</login-page>