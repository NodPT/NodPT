<copy-project-modal>
  <div class="modal fade" id="copyProjectModal" tabindex="-1" aria-labelledby="copyProjectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header border-secondary">
          <h5 class="modal-title" id="copyProjectModalLabel">
            <i class="bi bi-files me-2"></i>Copy Project
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick={resetModal}></button>
        </div>
        <div class="modal-body">
          <p class="text-muted mb-3">Create a copy of <strong>{state.currentProjectName}</strong></p>
          <div class="mb-3">
            <label for="copyProjectNameInput" class="form-label">New Project Name</label>
            <input type="text" class="form-control border-secondary" id="copyProjectNameInput"
              value={state.newProjectName} oninput={handleNameInput} onkeyup={handleKeyUp}
              placeholder="Enter new project name..." ref={projectNameInputRef} autofocus>
            <div class="form-text text-muted">
              Enter a name for the copied project
            </div>
          </div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick={resetModal} disabled={state.isCopying}>Cancel</button>
          <button type="button" class="btn btn-primary" onclick={copyProject} disabled={!state.newProjectName.trim() || state.isCopying}>
            <span if={state.isCopying}>
              <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
              Copying...
            </span>
            <span if={!state.isCopying}>
              <i class="bi bi-files me-1"></i>Copy Project
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { route } from '@riotjs/route'
    import { Modal } from 'bootstrap'
    import projectApiService from '../services/projectApiService'

    export default {
      state: {
        newProjectName: '',
        currentProjectName: 'Untitled Project',
        currentProjectId: null,
        isCopying: false
      },
      onBeforeMount() {
        projectApiService.setApi(this.api)
      },
      onMounted() {
        const modalElement = document.getElementById('copyProjectModal')
        if (modalElement) {
          modalElement.addEventListener('show.bs.modal', async () => {
            const urlParams = new URLSearchParams(window.location.search)
            const projectId = urlParams.get('pid') || urlParams.get('projectId')
            
            if (!projectId) {
              console.warn('No project ID found in URL')
              return
            }

            try {
              const project = await projectApiService.getProject(projectId)
              const projectName = project?.Name || 'Untitled Project'
              
              this.update({
                currentProjectName: projectName,
                currentProjectId: parseInt(projectId),
                newProjectName: `${projectName} Copy`
              })

              setTimeout(() => {
                if (this.projectNameInputEl) {
                  this.projectNameInputEl.focus()
                  this.projectNameInputEl.select()
                }
              }, 100)
            } catch (error) {
              console.error('Failed to load project:', error)
              this.update({
                currentProjectName: 'Untitled Project',
                currentProjectId: parseInt(projectId),
                newProjectName: 'Untitled Project Copy'
              })
            }
          })
        }
      },
      projectNameInputRef(el) {
        this.projectNameInputEl = el
      },
      notify(type, message) {
        const toast = window?.$toast
        if (toast && typeof toast[type] === 'function') {
          toast[type](message)
          return
        }
        console.log(message)
      },
      handleNameInput(event) {
        this.update({ newProjectName: event.target.value })
      },
      handleKeyUp(event) {
        if (event.key === 'Enter' && this.state.newProjectName.trim() && !this.state.isCopying) {
          this.copyProject()
        }
      },
      resetModal() {
        this.update({ newProjectName: '', isCopying: false })
      },
      copyProject() {
        // Note: API endpoint for copying projects is not yet implemented in backend
        // Until implemented, simply notify the user that this feature is coming soon
        this.notify('info', 'Project copy functionality will be implemented soon')
        
        const modalElement = document.getElementById('copyProjectModal')
        const modal = Modal.getInstance(modalElement)
        if (modal) {
          modal.hide()
        }

        setTimeout(() => {
          this.resetModal()
        }, 500)
      }
    }
  </script>
</copy-project-modal>
