<graph>
  <div class="d-flex flex-column min-vh-100">
    <div class="flex-grow-1" id="graph-canvas-container">
      <canvas id="graph-canvas" class=""></canvas>
    </div>
  </div>

  <script>
    import { initGraph, destroyGraph, setBus } from "../services/editorService"

    export default {
      state: {
      },
      onBeforeMount() {
        this.graphState = null
        this.initTimeoutId = null
      },
      onMounted() {
        setBus(this.bus, this.EVENT_TYPES)
        
        // Use requestAnimationFrame to ensure the DOM is fully rendered before initializing
        // This is more reliable than setTimeout, especially on mobile devices
        const RETRY_INTERVAL_MS = 100
        const MAX_WAIT_MS = 5000
        const MAX_RETRIES = MAX_WAIT_MS / RETRY_INTERVAL_MS
        let retryCount = 0
        
        const initializeGraph = () => {
          // Check if component is still mounted
          if (!this.$) {
            console.log('Graph component unmounted, canceling initialization')
            return
          }

          const canvas = document.getElementById('graph-canvas')
          const container = document.getElementById('graph-canvas-container')
          
          if (!canvas || !container) {
            console.error(`Graph initialization failed: ${!canvas ? 'canvas' : 'container'} element not found`)
            return
          }

          // Check if container has proper dimensions before initializing
          const containerRect = container.getBoundingClientRect()
          if (containerRect.width === 0 || containerRect.height === 0) {
            // Container not ready yet, retry after a short delay
            retryCount++
            if (retryCount < MAX_RETRIES) {
              this.initTimeoutId = setTimeout(initializeGraph, RETRY_INTERVAL_MS)
            } else {
              console.error('Failed to initialize graph: container dimensions never became valid after', MAX_RETRIES, 'retries (', MAX_WAIT_MS, 'ms total)')
            }
            return
          }

          try {
            // Don't create demo nodes automatically - let the editor page load project nodes
            this.graphState = initGraph(canvas, container,
              { autoArrange: true, layout: 'vertical', createDemo: false })

            // Notify that the editor is ready
            console.log('Graph initialized, triggering EDITOR_READY event')
            this.bus.trigger(this.EVENT_TYPES.EDITOR_READY)
          } catch (error) {
            console.error('Failed to initialize graph:', error)
          }
        }

        // Use requestAnimationFrame to ensure proper layout before initialization
        requestAnimationFrame(initializeGraph)
      },
      onBeforeUnmount() {
        // Clear any pending initialization timeout
        if (this.initTimeoutId) {
          clearTimeout(this.initTimeoutId)
          this.initTimeoutId = null
        }
        
        destroyGraph(this.graphState)
        this.graphState = null
      }
    }
  </script>
</graph>