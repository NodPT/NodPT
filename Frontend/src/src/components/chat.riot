<chat>
  <div class="chat-container">
    <div class="chat-messages" ref={chatMessagesRef}>
      <div each={message in state.messages} class={getMessageClass(message)}>
        <raw class={" message-content " + (message.thinking ? 'thinking' : '')} 
          html={renderMarkdown(message.content)}></raw>
        <div if={message.type !== 'ai' && message.type !== 'thinking'} 
          class="message-controls d-flex justify-content-start align-items-center mt-1">
          <button class="action-btn" onclick={() => copyMessage(message)} disabled={state.isLoading}
            title={message._copied
            ? 'Copied' : 'Copy to clipboard'}>
            <i class={"bi " + (message._copied ? 'bi-check-lg fw-bold' : 'bi-clipboard fw-bold')}></i>
          </button>
        </div>

        <div if={message.type === 'ai' || message.type === 'thinking'} class="message-actions">
              <div class="chat-response-buttons" if={!message.thinking}>
                <button class="action-btn" 
                  onclick={() => likeMessage(message)} 
                  disabled={state.isLoading} 
                  title="Like this response">
                  <i class={"bi bi-hand-thumbs-up fw-bold " + (message.Liked ? 'text-success' : '')}></i>
                </button>
                <button class="action-btn" onclick={() => dislikeMessage(message)} disabled={state.isLoading}
                    title="Dislike this response">
                    <i class={"bi bi-hand-thumbs-down fw-bold " + (message.Disliked ? 'text-danger' : '')}></i>
                </button>
                <button class="action-btn" onclick={() => copyMessage(message)} disabled={state.isLoading}
                      title={message._copied ? 'Copied' : 'Copy to clipboard'}>
                      <i class={"bi " + (message._copied ? 'bi-check-lg fw-bold' : 'bi-clipboard fw-bold')}></i>
                </button>
                <button if={message.type === 'ai' && !message.markedAsSolution} 
                        class="action-btn" onclick={buildSolution(message)} 
                        disabled={state.isLoading} title="Mark as solution">
                        <i class="bi bi-check2-circle fw-bold"></i>
                 </button>
                <span if={message.solutionPending} 
                  class="badge bg-warning text-dark ms-2">Processing</span>
                <span if={message.markedAsSolution} 
                  class="badge bg-success ms-2">
                  <i class="bi bi-check2-square me-1 fw-bold"></i>
                  <span>Solution</span>
                </span>
              </div>
        </div>

        <div class="message-time">{formatTime(message.timestamp)}</div>
      </div>
    </div>

    <div class="chat-input-container">
      <div class="chat-input-box h-100">
        <textarea class="chat-textarea form-control" 
          onkeyup={textAreaAdjust} placeholder="Ask anything..."
          value={state.newMessage} oninput={handleInput}
          onkeydown={handleEnter} ref={messageTextareaRef}
          disabled={state.isLoading}></textarea>
        <div class="chat-input-actions">
          <button class="btn send-btn" onclick={sendMessage} disabled={isSendDisabled}>
            <span if={state.isLoading} class="spinner-border spinner-border-sm"></span>
            <i if={!state.isLoading} class={"bi fw-bold " + (state.thinking ? 'bi-square-fill' : 'bi-send')}></i>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { marked } from 'marked'
    import DOMPurify from 'dompurify'
    import chatApiService from '../services/chatApiService.js'
    import nodeApiService from '../services/nodeApiService.js'
    import raw from '../components/raw.riot'

    export default {
      state: {
        messages: [],
        newMessage: '',
        isLoading: false,
        thinking: false,
        currentNodeId: null
      },
      // determine message CSS class based on type
      getMessageClass(message) {
        return " message " + (message.type === 'ai' || message.type === 'thinking' ? 'ai-message' : 'user-message')
      },
      // adjust textarea height based on content
      textAreaAdjust(el) {
        el.target.style.height = " 1px"; 
        const h = el.target.scrollHeight; 
        if (h > 150 || h < 60) return;
        el.target.style.height = (h) + "px";
        this.$$('.chat-input-container')[0].style.height = (36 + h) + "px";
      }, 
      onMounted() {
        // configure marked for markdown rendering
        marked.setOptions({ breaks: true, gfm: true, headerIds: false, mangle: false })
        // set some API services
        chatApiService.setApi(this.api); 
        nodeApiService.setApi(this.api); 
        this.resetChatMessages();
        this.handleNodeSelected = (nodeData) => {
          const nodeId = nodeData?.id || null
          if (this.state.currentNodeId === nodeId) {
            return
          }
          this.update({ currentNodeId: nodeId })
          this.loadChatData(nodeId)
        }
        this.handleProjectContextChange = () => this.resetChatMessages()
        this.handleAIResponseReceived = (data) => this.onAIResponseReceived(data)
        this.handleSolutionOutputReceived = (data) => this.onSolutionOutputReceived(data)

        this.bus.on(this.EVENT_TYPES.NODE_SELECTED, this.handleNodeSelected)
        this.bus.on(this.EVENT_TYPES.PROJECT_CONTEXT_CHANGED, this.handleProjectContextChange)
        this.bus.on(this.EVENT_TYPES.SIGNALR_AI_RESPONSE_RECEIVED, this.handleAIResponseReceived)
        this.bus.on(this.EVENT_TYPES.SOLUTION_OUTPUT_RECEIVED, this.handleSolutionOutputReceived)
      },
      onBeforeUnmount() {
          this.bus.off(this.EVENT_TYPES.NODE_SELECTED, this.handleNodeSelected)
          this.bus.off(this.EVENT_TYPES.PROJECT_CONTEXT_CHANGED, this.handleProjectContextChange)
          this.bus.off(this.EVENT_TYPES.SIGNALR_AI_RESPONSE_RECEIVED, this.handleAIResponseReceived)
          this.bus.off(this.EVENT_TYPES.SOLUTION_OUTPUT_RECEIVED, this.handleSolutionOutputReceived)
      },
      get isSendDisabled() {
        return this.state.isLoading || !this.state.newMessage.trim()
      },
      chatMessagesRef(el) {
        this.chatMessages = el
      },
      messageTextareaRef(el) {
        this.messageTextarea = el
      },
      handleInput(event) {
        this.update({ newMessage: event.target.value })
      },
      // send message on Enter key press
      handleEnter(event) {
        if (event.key === 'Enter' && !event.shiftKey) {
          event.preventDefault()
          this.sendMessage()
        }
      },
      // render markdown content safely
      renderMarkdown(content) {
        if (!content) return ''
        const rawHtml = marked(content)
        return DOMPurify.sanitize(rawHtml, {
          ALLOWED_TAGS: ['p', 'br', 'strong', 'em', 'code', 'pre', 'a', 'ul', 'ol', 'li', 'blockquote'],
          ALLOWED_ATTR: { a: ['href', 'target', 'rel'] },
          ALLOWED_URI_REGEXP: /^(?:(?:https?|mailto):)/i,
          ADD_ATTR: ['target', 'rel'],
          FORBID_ATTR: ['style', 'onerror', 'onload'],
          transformTags: {
            a: (el) => {
              const href = el.getAttribute('href') || ''
              if (/^https?:\/\//i.test(href)) {
                el.setAttribute('target', '_blank')
                el.setAttribute('rel', 'noopener noreferrer')
              }
              return el
            }
          }
        })
      },
      // format timestamp to readable string and local time
      formatTime(timestamp) {
        if (!timestamp) return ''
        return new Date(timestamp).toLocaleString()
      },
      // scroll chat to bottom
      scrollToBottom() {
        if (this.chatMessages) {
          this.chatMessages.scrollTop = this.chatMessages.scrollHeight
        }
      },
     // reset chat messages state
      resetChatMessages() {
        this.update({
          messages: [],
          newMessage: '',
          isLoading: false,
          thinking: false
        })
        this.scrollToBottom()
      },
      // load chat messages for the selected node
      async loadChatData(nodeId) {
        if (!nodeId) {
          this.resetChatMessages()
          return
        }
        try {
          const apiMessages = await chatApiService.getMessagesByNodeId(nodeId)
          const messages = apiMessages.map((msg) => ({
            id: msg.Id,
            type: msg.Sender === 'user' ? 'user' : 'ai',
            content: msg.Message,
            timestamp: msg.Timestamp,
            markedAsSolution: msg.MarkedAsSolution,
            solutionPending: false,
            Liked: msg.Liked || false,
            Disliked: msg.Disliked || false
          }))
          this.update({ messages: messages.length ? messages : [] })
          this.scrollToBottom()
        } catch (error) {
          console.error('Error loading chat data:', error)
          this.resetChatMessages()
        }
      },
      // remove any existing thinking message
      removeThinkingMessage() {
        const messages = this.state.messages.filter((msg) => !msg.thinking)
        this.update({ messages })
      },
      // Sends the user's message to the API and handles the response
      async sendMessage() {
        if (this.state.thinking) {
          this.update({ thinking: false })
          this.removeThinkingMessage()
          return
        }
        if (!this.state.newMessage.trim() || this.state.isLoading) {
          return
        }
        if (!this.state.currentNodeId) {
          console.error('Cannot send message: No node selected')
          return
        }

        const userMessageContent = this.state.newMessage
        this.update({ newMessage: '', isLoading: true })

        try {
          const userMessage = {
            id: Date.now(),
            type: 'user',
            content: userMessageContent,
            timestamp: new Date().toISOString()
          }
          this.update({ messages: [...this.state.messages, userMessage] })
          this.scrollToBottom()

          const response = await chatApiService.sendMessage({
            content: userMessageContent,
            nodeId: this.state.currentNodeId
          })

          if (response?.userMessage?.Id) {
            userMessage.id = response.userMessage.Id
          }

          const aiThinkingMessage = {
            id: Date.now() + 1,
            type: 'ai',
            content: 'thinking...',
            timestamp: new Date().toISOString(),
            markedAsSolution: false,
            solutionPending: false,
            Liked: false,
            Disliked: false,
            thinking: true
          }

          this.update({
            messages: [...this.state.messages, aiThinkingMessage],
            thinking: true
          })
          this.scrollToBottom()
        } catch (error) {
          console.error('Error sending message:', error)
          const errorMessage = {
            id: Date.now() + 1,
            type: 'ai',
            content: "Sorry, I'm having trouble processing your request. Please try again later.",
            timestamp: new Date().toISOString(),
            markedAsSolution: false,
            solutionPending: false,
            Liked: false,
            Disliked: false
          }
          this.update({ messages: [...this.state.messages, errorMessage] })
          this.scrollToBottom()
        } finally {
          this.update({ isLoading: false })
        }
      },
      // build solution from AI message
      async buildSolution(message) {
        if (this.state.isLoading || !message) return
        this.update({ isLoading: true })
        message.solutionPending = true
        try {
          await chatApiService.markAsSolution(message.id, this.state.currentNodeId)
          message.markedAsSolution = true
        } catch (error) {
          console.error('Error building solution:', error)
          message.markedAsSolution = false
        } finally {
          message.solutionPending = false
          this.update({ isLoading: false })
        }
      },
      // like and dislike message
      async likeMessage(message) {
        if (this.state.isLoading || !message) return
        try {
          const result = await chatApiService.likeMessage(message.id)
          message.Liked = result.Liked
          message.Disliked = result.Disliked
          this.update()
        } catch (error) {
          console.error('Error liking message:', error)
        }
      },
      async dislikeMessage(message) {
        if (this.state.isLoading || !message) return
        try {
          const result = await chatApiService.dislikeMessage(message.id)
          message.Liked = result.Liked
          message.Disliked = result.Disliked
          this.update()
        } catch (error) {
          console.error('Error disliking message:', error)
        }
      },
      // copy message content to clipboard
      async copyMessage(message) {
        if (!message?.content) return
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(message.content)
          } else {
            const el = document.createElement('textarea')
            el.value = message.content
            el.setAttribute('readonly', '')
            el.style.position = 'absolute'
            el.style.left = '-9999px'
            document.body.appendChild(el)
            el.select()
            document.execCommand('copy')
            document.body.removeChild(el)
          }
          message._copied = true
          setTimeout(() => { message._copied = false; this.update() }, 1600)
        } catch (err) {
          console.error('Copy failed', err)
        }
      },
      // Handle AI response received from the API
      onAIResponseReceived(data) {
        if (!data) return

        if (data.messageType === 'thinking') {
          this.removeThinkingMessage()
          const thinkingMessage = {
            id: `thinking-${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`,
            type: 'thinking',
            content: data.content,
            timestamp: data.timestamp,
            thinking: true,
            markedAsSolution: false,
            solutionPending: false,
            Liked: false,
            Disliked: false
          }
          this.update({ messages: [...this.state.messages, thinkingMessage], thinking: true })
          this.scrollToBottom()
          return
        }

        this.removeThinkingMessage()
        this.update({ thinking: false, isLoading: false })

        if (this.state.currentNodeId && data.nodeId && data.nodeId !== this.state.currentNodeId) {
          return
        }

        const aiMessage = {
          id: data.messageId,
          type: 'ai',
          content: data.content,
          timestamp: data.timestamp,
          markedAsSolution: false,
          solutionPending: false,
          Liked: false,
          Disliked: false
        }

        this.update({ messages: [...this.state.messages, aiMessage] })
        this.scrollToBottom()
      },
      // Handle solution output received from the API
      async onSolutionOutputReceived(data) {
        if (!data?.nodeId || !data.content) {
          return
        }

        let solutionPayload
        try {
          solutionPayload = JSON.parse(data.content)
        } catch (error) {
          console.error('Failed to parse solution output JSON:', error)
          const errorMessage = {
            id: `solution-parse-error-${Date.now()}`,
            type: 'ai',
            content: 'The solution output could not be applied because the AI returned invalid data. Please try again.',
            timestamp: new Date().toISOString(),
            markedAsSolution: false,
            solutionPending: false,
            Liked: false,
            Disliked: false
          }
          this.update({ messages: [...this.state.messages, errorMessage] })
          return
        }

        const solutionMessage = solutionPayload?.Message ?? solutionPayload?.message
        if (solutionMessage && data.messageId && data.nodeId === this.state.currentNodeId) {
          const targetMessage = this.state.messages
            .find(msg => msg.id === data.messageId);
          if (targetMessage) {
            targetMessage.content = solutionMessage
            targetMessage.markedAsSolution = true
            targetMessage.solutionPending = false
            this.update()
          }
        }

        const managers = Array.isArray(solutionPayload?.Managers)
          ? solutionPayload.Managers
          : Array.isArray(solutionPayload?.managers)
            ? solutionPayload.managers
            : []

        if (!managers.length) {
          return
        }

        this.bus.trigger(this.EVENT_TYPES.SOLUTION_MANAGERS_RECEIVED, {
          data: data,
          managers
        })

      }
    }
  </script>
</chat>