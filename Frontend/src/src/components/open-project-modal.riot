<open-project-modal>
    <div class="modal fade" id="openProjectModal" tabindex="-1" aria-labelledby="openProjectModalLabel"
        aria-hidden="true" ref={modalElementRef}>
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title" id="openProjectModalLabel">
                        <i class="bi bi-folder2-open me-2"></i>Open Recent Project
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <recent-projects ref={recentProjectsRef} />
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        import RecentProjects from './recent-projects.riot'

        export default {
            components: {
                RecentProjects
            },
            onMounted() {
                if (this.modalElement) {
                    this.modalShownHandler = () => this.handleModalShown()
                    this.modalElement.addEventListener('shown.bs.modal', this.modalShownHandler)
                }
            },
            onBeforeUnmount() {
                if (this.modalElement && this.modalShownHandler) {
                    this.modalElement.removeEventListener('shown.bs.modal', this.modalShownHandler)
                }
            },
            modalElementRef(el) {
                this.modalElement = el
            },
            recentProjectsRef(tag) {
                this.recentProjectsTag = tag
            },
            handleModalShown() {
                if (this.recentProjectsTag && typeof this.recentProjectsTag.loadProjects === 'function') {
                    this.recentProjectsTag.loadProjects()
                }
            }
        }
    </script>
</open-project-modal>