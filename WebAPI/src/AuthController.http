### AuthController Test Requests

# Base URL
@baseUrl = http://localhost:5049/api

### Login with Firebase token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "firebaseToken": "firebase_token_testuser123_john"
}

### Login with Firebase token (new user)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "firebaseToken": "firebase_token_newuser456_alice"
}

### Test invalid Firebase token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "firebaseToken": "invalid_token"
}

### Logout
GET {{baseUrl}}/auth/logout

### Get all users (to verify user creation and approval status)
GET {{baseUrl}}/users

### Get specific user by Firebase UID
GET {{baseUrl}}/users/testuser123

### Approve a user (Admin only - requires authentication)
PUT {{baseUrl}}/users/newuser456/approve
Content-Type: application/json

{
  "approved": true
}

### Revoke user approval (Admin only - requires authentication)
PUT {{baseUrl}}/users/newuser456/approve
Content-Type: application/json

{
  "approved": false
}

### Ban a user (Admin only - requires authentication)
PUT {{baseUrl}}/users/newuser456/ban
Content-Type: application/json

{
  "banned": true
}

### Unban a user (Admin only - requires authentication)
PUT {{baseUrl}}/users/newuser456/ban
Content-Type: application/json

{
  "banned": false
}