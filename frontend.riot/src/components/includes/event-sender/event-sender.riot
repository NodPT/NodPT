<event-sender>
  <div class="card mb-3">
    <div class="card-header">Event Sender Component</div>
    <div class="card-body">
      <input 
        type="text" 
        class="form-control mb-2" 
        placeholder="Enter message"
        value={state.message}
        oninput={handleInput}
      />
      <button class="btn btn-primary" onclick={sendEvent}>
        Send Event
      </button>
    </div>
  </div>

  <script>
    export default {
      state: {
        message: 'Hello from Event Sender!'
      },
      handleInput(e) {
        this.update({ message: e.target.value });
      },
      sendEvent() {
        // Use the event bus injected by the plugin
        this.$eventBus.trigger('custom-message', {
          text: this.state.message,
          timestamp: new Date().toISOString()
        });
        console.log('Event sent:', this.state.message);
      }
    }
  </script>
</event-sender>
