<event-receiver>
  <div class="card">
    <div class="card-header">Event Receiver Component</div>
    <div class="card-body">
      <h5>Received Messages:</h5>
      <ul class="list-group">
        <li 
          each={msg in state.messages} 
          class="list-group-item"
        >
          <strong>{msg.timestamp}:</strong> {msg.text}
        </li>
        <li if={state.messages.length === 0} class="list-group-item">
          No messages received yet...
        </li>
      </ul>
    </div>
  </div>

  <script>
    export default {
      state: {
        messages: []
      },
      onMounted() {
        // Listen to events using the event bus
        this.$eventBus.on('custom-message', this.handleMessage);
        console.log('Event receiver mounted and listening');
      },
      onBeforeUnmount() {
        // IMPORTANT: Always clean up listeners to prevent memory leaks
        this.$eventBus.off('custom-message', this.handleMessage);
        console.log('Event receiver unmounted and listener removed');
      },
      handleMessage(data) {
        console.log('Event received:', data);
        this.update({
          messages: [...this.state.messages, data]
        });
      }
    }
  </script>
</event-receiver>
