<graph>
  <div class="d-flex flex-column min-vh-100">
    <div class="container-fluid py-3 border-bottom bg-white">
      <div class="d-flex align-items-center justify-content-between">
        <h1 class="h5 mb-0">LiteGraph Editor Demo</h1>
        <a href="/" class="btn btn-sm btn-outline-secondary">Back</a>
      </div>
      <p class="text-muted small mb-0">Demo graph using litegraph.js default theme.</p>
    </div>

    <div class="flex-grow-1" id="graph-canvas-container">
      <canvas id="graph-canvas" class="w-100 h-100 d-block"></canvas>
    </div>
  </div>

  <script>
    import { initGraph, destroyGraph } from "../services/editorService"

    export default {
      state: {
      },
      onBeforeMount() {
        this.graphState = null
      },
      onMounted() {
        const canvas = document.getElementById('graph-canvas')
        const container = document.getElementById('graph-canvas-container')
        if (canvas && container) {
          this.graphState = initGraph(canvas, container, 
          {autoArrange: true, layout: 'vertical'} )
        }
      },
      onBeforeUnmount() {
        destroyGraph(this.graphState)
        this.graphState = null
      }
    }
  </script>
</graph>
