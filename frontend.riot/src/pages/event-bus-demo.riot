<event-bus-demo>
  <div class="container mt-4">
    <h1>Event Bus Demo</h1>
    <p class="lead">
      This page demonstrates the event bus plugin using <code>@riotjs/observable</code> and <code>riot.install</code>.
      Components can communicate without direct coupling.
    </p>
    
    <div class="row">
      <div class="col-md-6">
        <event-sender />
      </div>
      <div class="col-md-6">
        <event-receiver />
      </div>
    </div>

    <div class="mt-4">
      <h2>How It Works</h2>
      <ul>
        <li>The <strong>Event Sender</strong> component triggers events using <code>this.$eventBus.trigger('event-name', data)</code></li>
        <li>The <strong>Event Receiver</strong> component listens to events using <code>this.$eventBus.on('event-name', handler)</code></li>
        <li>The event bus is injected into all components via <code>riot.install()</code></li>
        <li>Always remove listeners in <code>onBeforeUnmount()</code> to prevent memory leaks</li>
      </ul>
    </div>
  </div>

  <script>
    import EventSender from '../components/includes/event-sender/event-sender.riot';
    import EventReceiver from '../components/includes/event-receiver/event-receiver.riot';

    export default {
      components: {
        EventSender,
        EventReceiver
      }
    }
  </script>
</event-bus-demo>
