# SignalR Configuration
# Base URL for SignalR hub (default: http://localhost:5049)
VITE_SIGNALR_BASE_URL=http://localhost:5049/signalr

# API Configuration
# Base URL for backend API (default: http://localhost:5049/api)
VITE_API_BASE_URL=http://localhost:5049/api

# Environment mode (Development, QA, or PROD)
# In Development mode, authentication checks are bypassed for testing
VITE_ENV=Development

# Firebase configuration (add your Firebase project's values)
VITE_FIREBASE_SHIT=your_firebase_config
